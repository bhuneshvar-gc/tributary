{
  "name": "@bhuneshvar-k/tributary-core",
  "version": "0.1.0",
  "description": "Referentially-consistent Postgres subsetting & sync engine",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhuneshvar-gc/tributary.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "@bhuneshvar-k/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "pg-copy-streams": "^7.0.0",
    "pg-format": "^1.0.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/pg-format": "^1.0.5"
  }
}
